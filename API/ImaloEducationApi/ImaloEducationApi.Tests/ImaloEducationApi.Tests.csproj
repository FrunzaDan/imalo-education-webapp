<Project Sdk="Microsoft.NET.Sdk">

    <!-- xUnit v3 on Microsoft Testing Platform v2: the test project is its own executable
         (dotnet test / dotnet run both work; see the repo-root global.json). -->
    <PropertyGroup>
        <OutputType>Exe</OutputType>
        <IsPackable>false</IsPackable>
    </PropertyGroup>

    <ItemGroup>
        <Content Include="xunit.runner.json" CopyToOutputDirectory="PreserveNewest" />
    </ItemGroup>

    <ItemGroup>
        <PackageReference Include="Microsoft.Testing.Extensions.CodeCoverage" />
        <PackageReference Include="Moq" />
        <PackageReference Include="xunit.v3.mtp-v2" />
    </ItemGroup>

    <ItemGroup>
        <Using Include="Xunit" />
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\ImaloEducationApi\ImaloEducationApi.csproj" />
    </ItemGroup>

</Project>
