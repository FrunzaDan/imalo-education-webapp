{
  "version": "0.2.0",
  "configurations": [
    {
      "name": ".NET Core Launch with Chrome",
      "type": "coreclr",
      "request": "launch",
      "preLaunchTask": "build",
      "program": "${workspaceFolder}/bin/Debug/net10.0/ImaloEducationApi.dll",
      "args": [],
      "cwd": "${workspaceFolder}",
      "stopAtEntry": false,
      "serverReadyAction": {
        "action": "openExternally",
        "pattern": "\\bNow listening on:\\s+(https?://\\S+)",
        "uriFormat": "%s/swagger"
      },
      "launchBrowser": {
        "enabled": true,
        "args": "http://localhost:5244/swagger",
        "windows": {
          "command": "cmd.exe",
          "args": "/C start chrome http://localhost:5244/swagger"
        },
        "osx": {
          "command": "open",
          "args": "-a 'Google Chrome' http://localhost:5244/swagger"
        },
        "linux": {
          "command": "google-chrome",
          "args": "http://localhost:5244/swagger"
        }
      },
      "env": {
        "ASPNETCORE_ENVIRONMENT": "Development"
      },
      "sourceFileMap": {
        "/Views": "${workspaceFolder}/Views"
      }
    }
  ]
}
