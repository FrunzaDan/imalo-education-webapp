	"item": [
		{
			"name": "scholars",
			"item": [
				{
					"name": "1. Create Scholar",
					"request": {
						"method": "POST",
						"header": [],
						"url": {
							"raw": "{{baseUrl}}/api/scholars",
							"host": [
								"{{baseUrl}}"
							],
							"path": [
								"api",
								"scholars"
							]
						},
						"body": {
							"mode": "raw",
							"raw": "{\n    \"firstName\": \"{{scholarFirstName}}\",\n    \"lastName\": \"{{scholarLastName}}\",\n    \"schoolId\": 1,\n    \"grade\": 5,\n    \"birthDate\": \"2015-04-12\",\n    \"pickupSchedule\": {\n        \"monday\": \"15:30\",\n        \"tuesday\": null,\n        \"wednesday\": \"15:30\",\n        \"thursday\": null,\n        \"friday\": \"14:00\"\n    },\n    \"motherFirstName\": \"Jane\",\n    \"motherLastName\": \"Doe\",\n    \"motherPhoneNumber\": \"15551234567\",\n    \"fatherFirstName\": \"John\",\n    \"fatherLastName\": \"Doe\",\n    \"fatherPhoneNumber\": \"15559876543\"\n}",
							"options": {
								"raw": {
									"language": "json"
								}
							}
						},
						"description": "Creates a new scholar with a fresh, randomly-generated name each run (built in the Pre-request Script) so this step — and the whole folder — is safe to re-run without colliding with a previous pass. The ID is always generated by the database (`NEWSEQUENTIALID()`), never client-supplied.\n\nUnlike some sibling projects' register endpoints, `CreatedAtAction` returns the full created `Scholar` (including its server-generated `scholarId`) directly in the response body — no separate lookup-by-field step is needed to capture it, see ai_docs/api.md."
					},
					"response": [],
					"event": [
						{
							"listen": "prerequest",
							"script": {
								"type": "text/javascript",
								"exec": [
									"const rand = Date.now() + Math.floor(Math.random() * 1000);",
									"pm.collectionVariables.set(\"scholarFirstName\", \"Test\" + String(rand).slice(-6));",
									"pm.collectionVariables.set(\"scholarLastName\", \"Scholar\" + String(rand).slice(-4));"
								]
							}
						},
						{
							"listen": "test",
							"script": {
								"type": "text/javascript",
								"exec": [
									"pm.test(\"Status code is 201\", () => pm.response.to.have.status(201));",
									"",
									"const body = pm.response.json();",
									"pm.test(\"Response contains a server-generated id\", () => {",
									"    pm.expect(body).to.have.property(\"id\").that.is.a(\"string\").and.is.not.empty;",
									"});",
									"",
									"if (body && body.scholarId) {",
									"    pm.collectionVariables.set(\"scholarId\", body.scholarId);",
									"}"
								]
							}
						}
					]
				},
				{
					"name": "2. Get Scholar By Id",
					"request": {
						"method": "GET",
						"header": [],
						"url": {
							"raw": "{{baseUrl}}/api/scholars/{{scholarId}}",
							"host": [
								"{{baseUrl}}"
							],
							"path": [
								"api",
								"scholars",
								"{{scholarId}}"
							]
						}
					},
					"response": [],
					"event": [
						{
							"listen": "test",
							"script": {
								"type": "text/javascript",
								"exec": [
									"pm.test(\"Status code is 200\", () => pm.response.to.have.status(200));",
									"",
									"const body = pm.response.json();",
									"pm.test(\"firstName matches the scholar just created\", () => {",
									"    pm.expect(body.firstName).to.eql(pm.collectionVariables.get(\"scholarFirstName\"));",
									"});"
								]
							}
						}
					]
				},
				{
					"name": "3. Update Scholar",
					"request": {
						"method": "PUT",
						"header": [],
						"url": {
							"raw": "{{baseUrl}}/api/scholars/{{scholarId}}",
							"host": [
								"{{baseUrl}}"
							],
							"path": [
								"api",
								"scholars",
								"{{scholarId}}"
							]
						},
						"body": {
							"mode": "raw",
							"raw": "{\n    \"scholarId\": \"{{scholarId}}\",\n    \"firstName\": \"{{scholarFirstName}}\",\n    \"lastName\": \"{{scholarLastName}}\",\n    \"schoolId\": 1,\n    \"grade\": 6,\n    \"birthDate\": \"2015-04-12\",\n    \"pickupSchedule\": {\n        \"monday\": \"16:00\",\n        \"wednesday\": \"16:00\"\n    },\n    \"motherFirstName\": \"Jane\",\n    \"motherLastName\": \"Doe\",\n    \"motherPhoneNumber\": \"15551234567\"\n}",
							"options": {
								"raw": {
									"language": "json"
								}
							}
						},
						"description": "Full replace, not a partial patch — fields left out of the body (like `fatherFirstName` here) are cleared, not left unchanged (contrast with sibling projects' `ISNULL(@param, column)` partial-update pattern). The URL id and the body's `id` must match, or the controller returns `400` before touching the data layer, see Negative & Edge Cases."
					},
					"response": [],
					"event": [
						{
							"listen": "test",
							"script": {
								"type": "text/javascript",
								"exec": [
									"pm.test(\"Status code is 200\", () => pm.response.to.have.status(200));",
									"",
									"const body = pm.response.json();",
									"pm.test(\"grade reflects the edit\", () => pm.expect(body.grade).to.eql(6));"
								]
							}
						}
					]
				},
				{
					"name": "4. List All Scholars",
					"request": {
						"method": "GET",
						"header": [],
						"url": {
							"raw": "{{baseUrl}}/api/scholars",
							"host": [
								"{{baseUrl}}"
							],
							"path": [
								"api",
								"scholars"
							]
						},
						"description": "No pagination, no filtering — returns every scholar in one call. Backs the main scholar table in the UI."
					},
					"response": [],
					"event": [
						{
							"listen": "test",
							"script": {
								"type": "text/javascript",
								"exec": [
									"pm.test(\"Status code is 200\", () => pm.response.to.have.status(200));",
									"",
									"const body = pm.response.json();",
									"pm.test(\"Response is an array containing the scholar just created\", () => {",
									"    pm.expect(body).to.be.an(\"array\");",
									"    pm.expect(body.some(s => s.scholarId === pm.collectionVariables.get(\"scholarId\"))).to.be.true;",
									"});"
								]
							}
						}
					]
				},
				{
					"name": "5. Get Scholar Audit Log",
					"request": {
						"method": "GET",
						"header": [],
						"url": {
							"raw": "{{baseUrl}}/api/scholars/{{scholarId}}/audit-log",
							"host": [
								"{{baseUrl}}"
							],
							"path": [
								"api",
								"scholars",
								"{{scholarId}}",
								"audit-log"
							]
						},
						"description": "Newest-first trail of every mutation on this scholar so far: Created, Updated."
					},
					"response": [],
					"event": [
						{
							"listen": "test",
							"script": {
								"type": "text/javascript",
								"exec": [
									"pm.test(\"Status code is 200\", () => pm.response.to.have.status(200));",
									"",
									"const body = pm.response.json();",
									"pm.test(\"At least 2 audit entries recorded (Created, Updated)\", () => {",
									"    pm.expect(body).to.be.an(\"array\").with.lengthOf.at.least(2);",
									"});"
								]
							}
						}
					]
				},
				{
					"name": "6. Delete Scholar",
					"request": {
						"method": "DELETE",
						"header": [],
						"url": {
							"raw": "{{baseUrl}}/api/scholars/{{scholarId}}",
							"host": [
								"{{baseUrl}}"
							],
							"path": [
								"api",
								"scholars",
								"{{scholarId}}"
							]
						},
						"description": "Cascades to `ScholarPickupSchedule`, `ScholarAttendance`, `ScholarParent` via DB `ON DELETE CASCADE` — the controller doesn't delete children itself, see ai_docs/database.md."
					},
					"response": [],
					"event": [
						{
							"listen": "test",
							"script": {
								"type": "text/javascript",
								"exec": [
									"pm.test(\"Status code is 204\", () => pm.response.to.have.status(204));"
								]
							}
						}
					]
				},
				{
					"name": "7. Get Scholar By Id (confirm deleted, expect 404)",
					"request": {
						"method": "GET",
						"header": [],
						"url": {
							"raw": "{{baseUrl}}/api/scholars/{{scholarId}}",
							"host": [
								"{{baseUrl}}"
							],
							"path": [
								"api",
								"scholars",
								"{{scholarId}}"
							]
						}
					},
					"response": [],
					"event": [
						{
							"listen": "test",
							"script": {
								"type": "text/javascript",
								"exec": [
									"pm.test(\"Status code is 404\", () => pm.response.to.have.status(404));"
								]
							}
						}
					]
				}
			],
			"description": "Run this folder top-to-bottom (or with Collection Runner). Each numbered step chains off the previous one via collection variables and the whole folder is self-cleaning — it deletes the scholar it creates in step 1, so it's safe to run repeatedly."
		},
		{
			"name": "Attendance",
			"item": [
				{
					"name": "1. Create Helper Scholar",
					"request": {
						"method": "POST",
						"header": [],
						"url": {
							"raw": "{{baseUrl}}/api/scholars",
							"host": [
								"{{baseUrl}}"
							],
							"path": [
								"api",
								"scholars"
							]
						},
						"body": {
							"mode": "raw",
							"raw": "{\n    \"firstName\": \"{{attendanceFirstName}}\",\n    \"lastName\": \"{{attendanceLastName}}\",\n    \"birthDate\": \"2016-09-01\"\n}",
							"options": {
								"raw": {
									"language": "json"
								}
							}
						},
						"description": "Registers a throwaway scholar for this folder's attendance steps and captures its server-generated id. Independent of the Scholars folder (that folder deletes its own scholar), so this folder can be run on its own."
					},
					"response": [],
					"event": [
						{
							"listen": "prerequest",
							"script": {
								"type": "text/javascript",
								"exec": [
									"const rand = Date.now() + Math.floor(Math.random() * 1000);",
									"pm.collectionVariables.set(\"attendanceFirstName\", \"Test\" + String(rand).slice(-6));",
									"pm.collectionVariables.set(\"attendanceLastName\", \"Attend\" + String(rand).slice(-4));"
								]
							}
						},
						{
							"listen": "test",
							"script": {
								"type": "text/javascript",
								"exec": [
									"pm.test(\"Status code is 201\", () => pm.response.to.have.status(201));",
									"",
									"const body = pm.response.json();",
									"if (body && body.scholarId) {",
									"    pm.collectionVariables.set(\"attendanceScholarId\", body.scholarId);",
									"}"
								]
							}
						}
					]
				},
				{
					"name": "2. Save Attendance (Create/Update)",
					"request": {
						"method": "POST",
						"header": [],
						"url": {
							"raw": "{{baseUrl}}/api/scholars/{{attendanceScholarId}}/attendance",
							"host": [
								"{{baseUrl}}"
							],
							"path": [
								"api",
								"scholars",
								"{{attendanceScholarId}}",
								"attendance"
							]
						},
						"body": {
							"mode": "raw",
							"raw": "[\n    {\n        \"date\": \"2026-09-14\",\n        \"lunchCost\": 5.5,\n        \"transportCost\": 2.0,\n        \"present\": true,\n        \"lunchSelected\": true,\n        \"transportSelected\": true\n    },\n    {\n        \"date\": \"2026-09-15\",\n        \"lunchCost\": 5.5,\n        \"transportCost\": 2.0,\n        \"present\": false,\n        \"lunchSelected\": false,\n        \"transportSelected\": false\n    }\n]",
							"options": {
								"raw": {
									"language": "json"
								}
							}
						},
						"description": "Upserts (replaces) the scholar's whole attendance list in one call — not a per-day patch. `present: false` requires both `lunchSelected`/`transportSelected` to also be `false`, or the API rejects the whole request with `400` (see Negative & Edge Cases)."
					},
					"response": [],
					"event": [
						{
							"listen": "test",
							"script": {
								"type": "text/javascript",
								"exec": [
									"pm.test(\"Status code is 204\", () => pm.response.to.have.status(204));"
								]
							}
						}
					]
				},
				{
					"name": "3. Get Attendance For Scholar",
					"request": {
						"method": "GET",
						"header": [],
						"url": {
							"raw": "{{baseUrl}}/api/scholars/{{attendanceScholarId}}/attendance",
							"host": [
								"{{baseUrl}}"
							],
							"path": [
								"api",
								"scholars",
								"{{attendanceScholarId}}",
								"attendance"
							]
						}
					},
					"response": [],
					"event": [
						{
							"listen": "test",
							"script": {
								"type": "text/javascript",
								"exec": [
									"pm.test(\"Status code is 200\", () => pm.response.to.have.status(200));",
									"",
									"const body = pm.response.json();",
									"pm.test(\"Both saved records come back\", () => {",
									"    pm.expect(body).to.be.an(\"array\").with.lengthOf(2);",
									"});"
								]
							}
						}
					]
				},
				{
					"name": "4. Get All Attendance (every scholar)",
					"request": {
						"method": "GET",
						"header": [],
						"url": {
							"raw": "{{baseUrl}}/api/scholars/attendance",
							"host": [
								"{{baseUrl}}"
							],
							"path": [
								"api",
								"scholars",
								"attendance"
							]
						},
						"description": "Every scholar's attendance in one call, shape `[{ scholarId, attendance: AttendanceRecord[] }]`. Backs the attendance dashboard, not the per-scholar page."
					},
					"response": [],
					"event": [
						{
							"listen": "test",
							"script": {
								"type": "text/javascript",
								"exec": [
									"pm.test(\"Status code is 200\", () => pm.response.to.have.status(200));",
									"",
									"const body = pm.response.json();",
									"pm.test(\"Response is an array including the helper scholar\", () => {",
									"    pm.expect(body).to.be.an(\"array\");",
									"    pm.expect(body.some(a => a.scholarId === pm.collectionVariables.get(\"attendanceScholarId\"))).to.be.true;",
									"});"
								]
							}
						}
					]
				},
				{
					"name": "5. Delete Attendance",
					"request": {
						"method": "DELETE",
						"header": [],
						"url": {
							"raw": "{{baseUrl}}/api/scholars/{{attendanceScholarId}}/attendance",
							"host": [
								"{{baseUrl}}"
							],
							"path": [
								"api",
								"scholars",
								"{{attendanceScholarId}}",
								"attendance"
							]
						}
					},
					"response": [],
					"event": [
						{
							"listen": "test",
							"script": {
								"type": "text/javascript",
								"exec": [
									"pm.test(\"Status code is 204\", () => pm.response.to.have.status(204));"
								]
							}
						}
					]
				},
				{
					"name": "6. Delete Helper Scholar (cleanup)",
					"request": {
						"method": "DELETE",
						"header": [],
						"url": {
							"raw": "{{baseUrl}}/api/scholars/{{attendanceScholarId}}",
							"host": [
								"{{baseUrl}}"
							],
							"path": [
								"api",
								"scholars",
								"{{attendanceScholarId}}"
							]
						}
					},
					"response": [],
					"event": [
						{
							"listen": "test",
							"script": {
								"type": "text/javascript",
								"exec": [
									"pm.test(\"Status code is 204\", () => pm.response.to.have.status(204));"
								]
							}
						}
					]
				}
			],
			"description": "Self-contained, self-cleaning walk through a helper scholar's attendance: save → get-for-scholar → get-all → delete → cleanup. Safe to run repeatedly."
		},
		{
			"name": "Audit Log",
			"item": [
				{
					"name": "Get Global Audit Log (paginated)",
					"request": {
						"method": "GET",
						"header": [],
						"url": {
							"raw": "{{baseUrl}}/api/scholars/audit-log/all?pageNumber=1&pageSize=20",
							"host": [
								"{{baseUrl}}"
							],
							"path": [
								"api",
								"scholars",
								"audit-log",
								"all"
							],
							"query": [
								{
									"key": "pageNumber",
									"value": "1"
								},
								{
									"key": "pageSize",
									"value": "20"
								}
							]
						},
						"description": "Newest-first across every scholar. Rows for a since-deleted scholar still show up, with `firstName`/`lastName` as `null` rather than disappearing (LEFT JOIN against `Scholars`, see ai_docs/database.md)."
					},
					"response": [],
					"event": [
						{
							"listen": "test",
							"script": {
								"type": "text/javascript",
								"exec": [
									"pm.test(\"Status code is 200\", () => pm.response.to.have.status(200));",
									"",
									"const body = pm.response.json();",
									"pm.test(\"Response is a paged list\", () => {",
									"    pm.expect(body).to.have.property(\"items\").that.is.an(\"array\");",
									"    pm.expect(body).to.have.property(\"totalItems\");",
									"    pm.expect(body.pageNumber).to.eql(1);",
									"});"
								]
							}
						}
					]
				},
				{
					"name": "Delete ALL Audit Log Entries (DESTRUCTIVE)",
					"request": {
						"method": "DELETE",
						"header": [],
						"url": {
							"raw": "{{baseUrl}}/api/scholars/audit-log/all",
							"host": [
								"{{baseUrl}}"
							],
							"path": [
								"api",
								"scholars",
