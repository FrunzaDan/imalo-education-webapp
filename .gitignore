# See https://docs.github.com/get-started/getting-started-with-git/ignoring-files for more about ignoring files.

# --- Compiled Output & Build Artifacts ---
# Angular build output
/UI/dist/
/UI/tmp/
/UI/out-tsc/
/UI/bazel-out/
/UI/.angular/cache/
/UI/coverage/

# ImaloEducation (DB project) build output
/DB/ImaloEducation/bin/
/DB/ImaloEducation/obj/

# SQL Server Data Tools (SSDT) intermediate files
*.dbmdl
*.sqlproj.user

# .NET / C# build output
/API/ImaloEducationApi/ImaloEducationApi/bin/
/API/ImaloEducationApi/ImaloEducationApi/obj/
/API/ImaloEducationApi/ImaloEducationApi/publish/
/API/ImaloEducationApi/ImaloEducationApi.Tests/bin/
/API/ImaloEducationApi/ImaloEducationApi.Tests/obj/

# dotnet test results (in the API folder and at the repo root)
[Tt]est[Rr]esult*/

# Debugging symbols
*.pdb
# Visual Studio Solution User Options
*.suo
# Visual Studio user settings
*.user
# Backup files
*.bak

# --- Dependencies ---
# Node.js modules for Angular
/UI/node_modules/
npm-debug.log
yarn-error.log
.pnp/
.pnp.js

# .NET packages
# NuGet packages are typically restored, not committed
packages/
# Rider and ReSharper specific files
*.DotSettings.user
*.resharper
*.dotsettings

# --- IDEs and Editors ---
.idea/
.project
.classpath
.c9/
*.launch
.settings/
*.sublime-workspace
*.vspscc
*.vssscc
# Visual Studio hidden folder for solution-specific files
.vs/

# Visual Studio Code
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json
.history/

# --- Miscellaneous ---
.sass-cache/
/connect.lock
/libpeerconnection.log
testem.log
/typings
# General log files
*.log
# If using local SQLite databases
*.sqlite

# --- System Files ---
.DS_Store
Thumbs.db

# --- Local dev orchestration (run.sh) ---
/.run/

# --- Environment Specific Configuration ---
# You might want to ignore appsettings.Development.json or other environment-specific
# config files if they contain sensitive information or are managed separately.
